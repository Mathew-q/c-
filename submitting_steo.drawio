<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36 Edg/128.0.0.0" version="24.7.13">
  <diagram name="Page-1" id="KjhQgxA5WtygTDXYkJ-I">
    <mxGraphModel dx="746" dy="457" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tRnWbjLhNTg3fLnv19oh-1" value="&lt;a href=&quot;https://www.kernel.org/doc/html/v4.17/process/submitting-patches.html&quot;&gt;Submitting patches: the essential guide to getting your code into the kernel — The Linux Kernel documentation&lt;/a&gt;" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.start_1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tRnWbjLhNTg3fLnv19oh-2" value="0.克隆" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="290" y="160" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tRnWbjLhNTg3fLnv19oh-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="tRnWbjLhNTg3fLnv19oh-4" target="tRnWbjLhNTg3fLnv19oh-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tRnWbjLhNTg3fLnv19oh-4" value="1.diff(git add会自带)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="290" y="260" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tRnWbjLhNTg3fLnv19oh-5" value="2. 描述：实例&lt;div&gt;&lt;h3 style=&quot;box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Helvetica, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;; text-align: start; background-color: rgb(248, 249, 250);&quot;&gt;总结如何正确描述修改&lt;/h3&gt;&lt;ol style=&quot;box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Helvetica, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;; font-size: 13px; text-align: start; background-color: rgb(248, 249, 250);&quot;&gt;&lt;li style=&quot;box-sizing: border-box; padding-left: 4px;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; margin-top: 0px; margin-bottom: 0px;&quot;&gt;&lt;span style=&quot;box-sizing: border-box; font-weight: bolder;&quot;&gt;描述问题&lt;/span&gt;：清楚地说明问题是什么，以及为什么需要修复。&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box; padding-left: 4px;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; margin-top: 0px; margin-bottom: 0px;&quot;&gt;&lt;span style=&quot;box-sizing: border-box; font-weight: bolder;&quot;&gt;用户影响&lt;/span&gt;：描述问题对用户的影响，提供具体的例子和细节。&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box; padding-left: 4px;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; margin-top: 0px; margin-bottom: 0px;&quot;&gt;&lt;span style=&quot;box-sizing: border-box; font-weight: bolder;&quot;&gt;量化优化&lt;/span&gt;：如果有性能改进，提供具体数据，并描述可能的权衡。&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box; padding-left: 4px;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; margin-top: 0px; margin-bottom: 0px;&quot;&gt;&lt;span style=&quot;box-sizing: border-box; font-weight: bolder;&quot;&gt;技术细节&lt;/span&gt;：详细描述你所做的更改，确保审阅者能理解。&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box; padding-left: 4px;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; margin-top: 0px; margin-bottom: 0px;&quot;&gt;&lt;span style=&quot;box-sizing: border-box; font-weight: bolder;&quot;&gt;单一问题&lt;/span&gt;：每个补丁只解决一个问题，避免过于复杂。&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box; padding-left: 4px;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; margin-top: 0px; margin-bottom: 0px;&quot;&gt;&lt;span style=&quot;box-sizing: border-box; font-weight: bolder;&quot;&gt;自包含描述&lt;/span&gt;：确保补丁描述完整，不依赖外部资源。&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box; padding-left: 4px;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; margin-top: 0px; margin-bottom: 0px;&quot;&gt;&lt;span style=&quot;box-sizing: border-box; font-weight: bolder;&quot;&gt;命令式语气&lt;/span&gt;：用命令式语气描述更改。&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box; padding-left: 4px;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; margin-top: 0px; margin-bottom: 0px;&quot;&gt;&lt;span style=&quot;box-sizing: border-box; font-weight: bolder;&quot;&gt;引用相关提交&lt;/span&gt;：如果修复了特定提交中的问题，使用&amp;nbsp;&lt;code style=&quot;box-sizing: border-box; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.875rem; line-height: 1.55; padding: 0.125rem calc(0.3125rem); border-radius: 0.25rem; color: rgb(26, 27, 30); background-color: rgb(241, 243, 245);&quot; dir=&quot;ltr&quot; class=&quot;mantine-Code-root mantine-1x79vez&quot;&gt;Fixes:&lt;/code&gt;&amp;nbsp;标签，并提供相关信息。&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="130" y="370" width="520" height="260" as="geometry" />
        </mxCell>
        <mxCell id="tRnWbjLhNTg3fLnv19oh-7" value="3.分离，一个patch只有一个修改，保证一个逻辑。多个文件单一更改算一个；&lt;div&gt;另补丁有依赖需要进行说明&lt;/div&gt;&lt;div&gt;&lt;p style=&quot;box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Helvetica, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;; font-size: 13px; text-align: start; background-color: rgb(248, 249, 250);&quot;&gt;在将更改分成一系列补丁时，要特别注意确保内核在每个补丁后都能正确构建和运行。使用 git bisect 追踪问题的开发者可能会在任何点分割你的补丁系列；如果你在中间引入错误，他们不会感谢你。&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Helvetica, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;; font-size: 13px; text-align: start; background-color: rgb(248, 249, 250);&quot;&gt;如果你无法将补丁集压缩成更小的补丁集，那么一次只发布 15 个左右，并等待审查和集成&lt;/p&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="160" y="650" width="460" height="180" as="geometry" />
        </mxCell>
        <mxCell id="tRnWbjLhNTg3fLnv19oh-9" value="&lt;code style=&quot;box-sizing: border-box; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.875rem; line-height: 1.55; padding: 0.125rem calc(0.3125rem); border-radius: 0.25rem; color: rgb(26, 27, 30); background-color: rgb(241, 243, 245); text-align: start;&quot; dir=&quot;ltr&quot; class=&quot;mantine-Code-root mantine-1x79vez&quot;&gt;git bisect&lt;/code&gt;&lt;span style=&quot;font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Helvetica, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;; font-size: 13px; text-align: start; background-color: rgb(248, 249, 250);&quot;&gt;&amp;nbsp;是一个用于查找引入错误的提交的工具。它通过二分查找算法帮助你快速定位问题。&lt;/span&gt;" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.document2;whiteSpace=wrap;size=0.25;" vertex="1" parent="1">
          <mxGeometry x="670" y="670" width="190" height="140" as="geometry" />
        </mxCell>
        <mxCell id="tRnWbjLhNTg3fLnv19oh-10" value="4.检查样式" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="270" y="890" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tRnWbjLhNTg3fLnv19oh-11" value="&lt;h2 style=&quot;box-sizing: border-box; margin-top: 0px; font-family: &amp;quot;Roboto Slab&amp;quot;, ff-tisa-web-pro, Georgia, Arial, sans-serif; font-size: 24px; color: rgb(64, 64, 64); text-align: start; background-color: rgb(252, 252, 252);&quot;&gt;&lt;a style=&quot;background-color: initial; font-family: Helvetica; font-size: 12px; font-weight: normal; text-align: center;&quot; href=&quot;https://www.kernel.org/doc/html/v4.17/translations/zh_CN/coding-style.html&quot;&gt;Linux 内核代码风格 — The Linux Kernel documentation&lt;/a&gt;&lt;/h2&gt;&lt;h2 style=&quot;box-sizing: border-box; margin-top: 0px; font-family: &amp;quot;Roboto Slab&amp;quot;, ff-tisa-web-pro, Georgia, Arial, sans-serif; font-size: 24px; color: rgb(64, 64, 64); text-align: start; background-color: rgb(252, 252, 252);&quot;&gt;19) 内联汇编&lt;/h2&gt;&lt;h2 style=&quot;box-sizing: border-box; margin-top: 0px; font-family: &amp;quot;Roboto Slab&amp;quot;, ff-tisa-web-pro, Georgia, Arial, sans-serif; font-size: 24px; color: rgb(64, 64, 64); text-align: start; background-color: rgb(252, 252, 252);&quot;&gt;20) 条件编译&lt;/h2&gt;" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.document2;whiteSpace=wrap;size=0.25;" vertex="1" parent="1">
          <mxGeometry x="660" y="850" width="310" height="210" as="geometry" />
        </mxCell>
        <mxCell id="tRnWbjLhNTg3fLnv19oh-12" value="5.补丁接受者&lt;div&gt;&lt;span style=&quot;font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Helvetica, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;; font-size: 13px; text-align: left; background-color: rgb(248, 249, 250);&quot;&gt;查看 MAINTAINERS 文件和源代码修订历史以查看那些维护者是谁。脚本 scripts/get_maintainer.pl 在这一步非常有用。如果你找不到你正在处理的子系统的维护者&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="190" y="1090" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tRnWbjLhNTg3fLnv19oh-13" value="6.补丁文本形式" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="260" y="1230" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tRnWbjLhNTg3fLnv19oh-14" value="7.电子邮件大小。回复审查邮件，主题包含patch," style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="260" y="1410" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tRnWbjLhNTg3fLnv19oh-15" value="8.提交者其他身份" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="260" y="1560" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tRnWbjLhNTg3fLnv19oh-16" value="9.patch的格式" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="260" y="1700" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tRnWbjLhNTg3fLnv19oh-17" value="一个实例：&lt;div&gt;&lt;pre style=&quot;text-align: start; overflow-wrap: break-word; text-wrap: wrap;&quot;&gt;commit 2ac9deb7e087f0b461c3559d9eaa6b9cf19d3fa8&lt;br/&gt;Author: Bob Zhou &amp;lt;bob.zhou@amd.com&amp;gt;&lt;br/&gt;Date:   Fri May 31 15:01:22 2024 +0800&lt;br/&gt;&lt;br/&gt;    drm/amd/pm: Fix the null pointer dereference for vega10_hwmgr&lt;br/&gt;    &lt;br/&gt;    commit 50151b7f1c79a09117837eb95b76c2de76841dab upstream.&lt;br/&gt;    &lt;br/&gt;    Check return value and conduct null pointer handling to avoid null pointer dereference.&lt;br/&gt;    &lt;br/&gt;    Signed-off-by: Bob Zhou &amp;lt;bob.zhou@amd.com&amp;gt;&lt;br/&gt;    Reviewed-by: Tim Huang &amp;lt;Tim.Huang@amd.com&amp;gt;&lt;br/&gt;    Signed-off-by: Alex Deucher &amp;lt;alexander.deucher@amd.com&amp;gt;&lt;br/&gt;    Signed-off-by: Sasha Levin &amp;lt;sashal@kernel.org&amp;gt;&lt;br/&gt;    Signed-off-by: Mukul Sikka &amp;lt;mukul.sikka@broadcom.com&amp;gt;&lt;br/&gt;    Signed-off-by: Greg Kroah-Hartman &amp;lt;gregkh@linuxfoundation.org&amp;gt;&lt;/pre&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="120" y="1830" width="470" height="340" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
